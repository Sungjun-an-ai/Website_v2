NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=info@hsurethane.co.kr
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Internal test access gate ---
# Set SITE_GATE_ENABLED=false (or remove) to disable the gate once testing is done.
SITE_GATE_ENABLED=true
# Shared password testers enter on the /enter page.
SITE_GATE_PASSWORD=change_me
# Random secret stored in the access cookie (e.g. `openssl rand -hex 24`).
SITE_GATE_TOKEN=generate_a_random_token
